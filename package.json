{
  "name": "aireceptionistnow-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start --go",
    "start:dev-client": "expo start --dev-client",
    "android": "expo start --go --android",
    "ios": "expo start --go --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "preflight": "node scripts/preflight.mjs",
    "doctor": "npx expo-doctor",
    "eas-build-pre-install": "node scripts/preflight.mjs",
    "build:preview": "node scripts/preflight.mjs preview && eas build --profile preview",
    "build:production": "node scripts/preflight.mjs production && eas build --profile production",
    "verify": "npm run typecheck && npm run lint && npm run preflight && npx expo export --platform ios --output-dir dist --clear"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.23",
    "expo-apple-authentication": "~58.0.2",
    "expo-application": "~58.1.2",
    "expo-asset": "^58.0.18",
    "expo-audio": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-crypto": "~58.0.7",
    "expo-dev-client": "~58.0.18",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^4.7.2",
    "expo-linking": "~58.0.16",
    "expo-localization": "~58.0.5",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-purchases": "10.16.0",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "expo": {
      "@expo/cli": {
        "zod": "4.6.7"
      }
    }
  },
  "allowScripts": {
    "unrs-resolver": false
  }
}
