# Copy to .env and fill in. Every EXPO_PUBLIC_* value is embedded in the shipped
# binary and is readable by anyone who downloads the app - only ever put values
# here that are safe in public. The Supabase service-role key is NOT one of
# them: it never leaves the Next.js server.

# Where the /api/mobile/* routes live. Use your machine's LAN IP (not
# localhost - a device cannot reach the simulator host by that name) when
# running the web app locally, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=https://aireceptionistnow.com

# Same Supabase project as the web app. The publishable/anon key is public by
# design; RLS and the API's bearer check are what actually protect the data.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Android in-app purchases (RevenueCat). This is the PUBLIC Android SDK key
# (starts with goog_) and is safe to embed in the app. Never put the RevenueCat
# secret key (sk_...) here. For EAS builds set it per environment instead:
#   eas env:create --name EXPO_PUBLIC_REVENUECAT_ANDROID_KEY (preview + production)
# EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_...

# ---------------------------------------------------------------------------
# Development-only switches. Everything below is gated behind __DEV__ in code,
# so it is ignored (and stripped) in release builds - never set these in
# eas.json or the EAS environment.
# ---------------------------------------------------------------------------

# Mock API + a fake signed-in session, no backend needed.
# EXPO_PUBLIC_MOCK=1
#   Session: user (default) | guest
# EXPO_PUBLIC_MOCK_SESSION=user
#   Setup state: done | funnel (signed in, at the plan step) | fresh (signed in,
#   nothing set up). Default: done, or fresh when MOCK_SESSION=guest.
# EXPO_PUBLIC_MOCK_SETUP=done
#   Billing: none | apple | google | stripe | stripe_past_due | comp
#   (default: none when setup=funnel, apple when setup=done)
# EXPO_PUBLIC_MOCK_BILLING=apple
#   Billing reports the store Sandbox environment (test purchase, no real number).
# EXPO_PUBLIC_MOCK_SANDBOX=1
#   Number of assistants: 1 (default) | 2
# EXPO_PUBLIC_MOCK_ASSISTANTS=1
#   Comma-separated substrings. A mock request whose
#   "METHOD /path?query action=<body action>" contains one fails with a 500
#   (e.g. power, status=unanswered, action=provision); otp / verify fail sign-in.
# EXPO_PUBLIC_MOCK_FAIL=/api/mobile/billing

# Mock store adapter (no StoreKit / Play Billing), and what a purchase returns:
# purchased | cancelled | failed | pending | confirming
# EXPO_PUBLIC_IAP_MOCK=1
# EXPO_PUBLIC_IAP_MOCK_OUTCOME=purchased
